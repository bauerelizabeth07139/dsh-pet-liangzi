{
  "name": "dsh-pet-liangzi",
  "version": "1.0.0",
  "description": "The DeepSeek founder as an anime chibi — a calm, dependable father. A self-contained desktop pet for the DeepSeek Harness Web GUI: chibi sprite animation on a click-through overlay, voiced Chinese dialogue with subtitles, generated sound effects and background music — each on its own switch — plus an optional cross-plugin link that plays father-and-daughter scenes when both pets are installed.",
  "type": "module",
  "license": "MIT",
  "author": "bauerelizabeth07139",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bauerelizabeth07139/dsh-pet-liangzi.git"
  },
  "homepage": "https://github.com/bauerelizabeth07139/dsh-pet-liangzi#readme",
  "bugs": {
    "url": "https://github.com/bauerelizabeth07139/dsh-pet-liangzi/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.1.5-rc.1 <0.2.0-0 || >=0.2.0-rc.0 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "external": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "react": ">=18.2.0"
  },
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "desktop-pet",
    "desktoppet",
    "mascot",
    "桌宠",
    "liangzi",
    "梁子",
    "pet",
    "character",
    "voice",
    "bgm",
    "sound-effects",
    "family"
  ],
  "icon": "./assets/icon.png"
}
